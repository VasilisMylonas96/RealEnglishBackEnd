# ── Server ──────────────────────────────────────────────────────────────────
# Port the backend listens on. On Render/Railway this is set automatically.
PORT=4000

# Comma-separated list of allowed CORS origins (frontend dev server / deployed
# site). In production set this to your deployed frontend URL, e.g.
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=3h

# ── Database (PostgreSQL / Neon) ────────────────────────────────────────────
# Your Neon PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Example (Neon):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-xxx-pooler.eu-central-1.aws.neon.tech/neondb?schema=public&sslmode=require"
#
# For local development with a local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/realenglish?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/realenglish?schema=public"

# ── Public URLs ─────────────────────────────────────────────────────────────
# These are OPTIONAL. When unset, the backend derives the correct URL from
# each request's Host header, so production deployments work with no config.
# Set them only for local development convenience:
#   PUBLIC_BASE_URL  → where the API + /uploads are served (default localhost:4000)
#   APP_BASE_URL     → where the React frontend is served (default localhost:3000)
PUBLIC_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000

# ── Uploads directory ───────────────────────────────────────────────────────
# Optional. When set, the backend reads/writes media files from this absolute
# path instead of the default <project>/uploads folder. Useful on a server
# where media storage lives outside the repo (e.g. a mounted volume).
# UPLOADS_DIR=/var/data/realenglish/uploads

# ── Google Places API (optional) ────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Google Gemini (in-app AI assistant) ─────────────────────────────────────
# API key for the Gemini model, used by POST /api/assistant/chat.
# Get one at https://aistudio.google.com/apikey . Leave empty to disable the
# assistant (the endpoint returns a 503 "not configured" response).
GEMINI_API_KEY=

# Optional: pin a specific Gemini model. When unset, the server tries a
# fallback chain (gemini-2.5-flash → gemini-3.8-flash → gemini-flash-latest)
# because Google periodically retires models.
# GEMINI_MODEL=gemini-3.8-flash

# ── SMTP (invitation + video call emails) ───────────────────────────────────
# Leave MAIL_USER/MAIL_PASS empty to disable email sending (the app still
# works; emails are simply skipped with a warning in the logs).
#
# For Gmail: use an App Password (16 chars, no spaces) — not your account
# password. Create one at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Real English Academy <no-reply@realenglish.com>

# Where contact-form messages are forwarded (optional, default:
# realenglished@gmail.com).
CONTACT_INBOX=realenglished@gmail.com

# ── Frontend URL (for email links) ──────────────────────────────────────────
# Public frontend URL used in all email links and image URLs.
# In production set this to your HTTPS site URL, e.g. https://your-site.netlify.app
FRONTEND_URL=http://localhost:3000

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to "production" on the server. This makes the auth cookie `secure`
# (only sent over HTTPS). Leave unset for local development over HTTP.
# NODE_ENV=production
