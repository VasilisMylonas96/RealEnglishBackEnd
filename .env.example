# ── Server ──────────────────────────────────────────────────────────────────
# Port the backend listens on (Nginx proxies to this).
PORT=4000

# Comma-separated list of allowed CORS origins (the deployed frontend).
CORS_ORIGIN=https://realenglishacademy.netlify.app

# ── JWT ─────────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=3h

# ── Database (PostgreSQL / Neon) ────────────────────────────────────────────
# Your Neon PostgreSQL connection string (pooled endpoint).
# Format: postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Public URLs ─────────────────────────────────────────────────────────────
# PUBLIC_BASE_URL: where the API + /uploads are served. Used to build absolute
# media/attachment URLs (must be HTTPS in production to avoid mixed content).
PUBLIC_BASE_URL=https://realenglishacademy.duckdns.org

# APP_BASE_URL: where the React frontend is served (used by the AI provider
# HTTP-Referer header and as a fallback for invite links).
APP_BASE_URL=https://realenglishacademy.netlify.app

# FRONTEND_URL: public frontend URL used in all email links and image URLs.
FRONTEND_URL=https://realenglishacademy.netlify.app

# ── Uploads directory ───────────────────────────────────────────────────────
# Where media files are stored on the server. Must be persistent storage
# (Oracle's /home is ephemeral on reboot — use a mounted volume if available).
UPLOADS_DIR=/var/www/realenglish/uploads

# ── Google Places API (optional) ────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Google Gemini (in-app AI assistant) ─────────────────────────────────────
# API key for the Gemini model, used by POST /api/assistant/chat.
# Get one at https://aistudio.google.com/apikey . Leave empty to disable.
GEMINI_API_KEY=

# Optional: pin a specific Gemini model.
# GEMINI_MODEL=gemini-3.8-flash

# ── SMTP (invitation + video call emails) ───────────────────────────────────
# For Gmail: use an App Password (16 chars, no spaces) — not your account
# password. Create one at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Real English Academy <noreply.realenglishacademy@gmail.com>

# Where contact-form messages are forwarded.
CONTACT_INBOX=realenglished@gmail.com

# ── Runtime ─────────────────────────────────────────────────────────────────
# Set to "production" on the server. Makes the auth cookie `secure`
# (only sent over HTTPS).
NODE_ENV=production
