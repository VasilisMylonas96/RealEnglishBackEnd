// Real English Academy - Prisma schema
// PostgreSQL (Neon) for production. The connection string is read from the
// DATABASE_URL environment variable (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  firstName String?
  lastName  String?
  birthDate DateTime?
  username  String   @unique
  email     String?  @unique
  phone     String?
  password  String // bcrypt hash
  role      String   @default("STUDENT") // ADMIN | TEACHER | STUDENT (SQLite has no enums)
  level     String? // A-Junior | B-Junior | A-Senior | B-Senior | C-Junior | C-Senior
  avatarUrl String?
  lastSeenAt DateTime?
  // When true, the user must set a new password on next login (set by a
  // teacher/admin "Reset password" action). Cleared once the new password
  // is saved.
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupMemberships GroupMember[]
  eventParticipations CalendarEventStudent[]
  createdEvents CalendarEvent[] @relation("CalendarEventCreator")

  // Chat relations
  friendshipsRequested Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipAddressee")
  conversationsAsOne   Conversation[] @relation("ConversationParticipantOne")
  conversationsAsTwo   Conversation[] @relation("ConversationParticipantTwo")
  messagesSent         Message[] @relation("MessageSender")

  // Chat group relations (independent from calendar groups)
  chatGroupsCreated ChatGroup[] @relation("ChatGroupCreator")
  chatGroupMemberships ChatGroupMember[]
  chatGroupMessagesSent ChatGroupMessage[] @relation("ChatGroupMessageSender")
  chatGroupMessagesRead ChatGroupMessageRead[] @relation("ChatGroupMessageReader")
}

// Invitation tokens: single-use, time-limited, role-specific.
// Generated by the admin (bulk email or shareable link) and consumed
// exactly once during registration.
model InviteToken {
  id          String   @id @default(cuid())
  token       String   @unique // random opaque token embedded in the invite URL
  email       String? // target email (null for generic shareable links)
  role        String // TEACHER | STUDENT
  isUsed      Boolean  @default(false)
  usedById    String? // user id that redeemed the token
  createdById String? // user id who created this invite
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([token])
  @@index([email])
  @@index([createdById])
}

model PageContents {
  id         String   @id @default(cuid())
  page_key   String // e.g. 'home', 'about', 'gallery'
  element_id String // e.g. 'hero_title', 'award_2024_description'
  content    String // HTML or rich text content string
  styles     String? // JSON: font size, color, bold, alignment
  updatedAt  DateTime @updatedAt

  @@unique([page_key, element_id])
  @@index([page_key])
}

model MediaCategory {
  id        String   @id @default(cuid())
  name      String // display name, e.g. "The Bilingual Project"
  slug      String   @unique // URL-safe key, e.g. "thebilingualproject"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id           String   @id @default(cuid())
  gallery_id   String // category slug or 'carousel', 'hero', etc.
  url          String // permanent public URL path, e.g. /uploads/abc.webp
  filename     String // stored file name on disk
  originalName String
  mimeType     String
  size         Int // bytes after optimization
  width        Int?
  height       Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([gallery_id])
}

// In-house (site) reviews. Google reviews are fetched live from the API
// and are NOT stored here. In the future this table will accept new
// reviews submitted from the site (student accounts, etc.).
model Review {
  id         String   @id @default(cuid())
  userId     String?  @unique
  role       String? // Role of the in-house reviewer at submission time
  author     String
  rating     Int // 1-5
  text       String
  photo      String? // avatar URL
  reviewDate DateTime // when the review was written
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ─── Announcements ──────────────────────────────────────────────────────────

// A public announcement shown on the /announcements page. Content is rich
// HTML (text, inline images, lists, links). Instagram-sourced announcements
// are imported automatically (hourly sync + manual trigger) and deduplicated
// by instagramMediaId.
model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String // rich HTML
  authorName      String    @default("Real English Academy")
  source          String    @default("MANUAL") // MANUAL | INSTAGRAM
  instagramMediaId String?  @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
}

// ─── Quiz & Tournament System ───────────────────────────────────────────────

model Question {
  id                 String   @id @default(cuid())
  level              String // A-Junior | B-Junior | A-Senior | B-Senior | C-Junior | C-Senior
  cefrLevel          String? // A1 | A2 | B1 | B2 | C1 | C2
  difficulty         String // easy | medium | hard
  questionType       String   @default("MULTIPLE_CHOICE")
  topicSyllabusTag   String // e.g. "Present Simple", "Past Simple", "Articles"
  questionText       String
  options            String // JSON array of option strings or shuffled tokens
  questionData       String? // JSON metadata for the question type
  correctAnswer      Int // index into options array (0-based)
  correctAnswerText  String? // canonical text/JSON answer for non-choice questions
  explanation        String? // shown in review mode
  sourceFlag         String?
  isScannedSource    Boolean  @default(false)
  status             String   @default("ACTIVE")
  createdBy          String?
  points             Int      @default(10) // base points; scaled by difficulty
  createdAt          DateTime @default(now())
  updatedAt          DateTime? @updatedAt

  @@index([level, difficulty])
  @@index([level, topicSyllabusTag])
  @@index([status, cefrLevel, questionType, isScannedSource])
  @@index([sourceFlag])
  @@index([questionText])
}

model QuizExtractionJob {
  id            String   @id @default(cuid())
  mode          String // WORKSHEET | BOOK
  fileName      String
  sourceFlag    String?
  status        String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  totalBatches  Int      @default(0)
  doneBatches   Int      @default(0)
  questionsJson String? // JSON array of extracted questions (staging, not yet in bank)
  error         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuizModeConfig {
  id                    String   @id @default(cuid())
  mode                  String   @unique // DAILY | WEEKLY | TOURNAMENT | PRACTICE
  onlyScannedQuestions  Boolean  @default(false)
  allowedSourceFlags    String? // JSON array of source flag strings
  typeDistributionJson  String? // JSON map of question type to percentage
  updatedAt             DateTime @updatedAt
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizType       String // DAILY | WEEKLY | TOURNAMENT
  level          String // student's level at time of attempt
  totalQuestions Int
  correctCount   Int
  score          Int // total points earned
  durationSec    Int? // time taken in seconds
  answers        String // JSON: [{ questionId, selectedAnswer, correct, points }]
  startedAt      DateTime
  completedAt    DateTime
  createdAt      DateTime @default(now())
  matchId        String? // TournamentMatch id (TOURNAMENT attempts only)

  @@index([userId, quizType])
  @@index([userId, completedAt])
  @@index([matchId])
}

model Tournament {
  id               String   @id @default(cuid())
  name             String
  scheduledAt      DateTime // when the tournament starts
  durationMin      Int      @default(15) // duration for 20-question rounds
  finalDurationMin Int      @default(20) // duration for the 30-question final
  questionCount    Int      @default(20) // retained for compatibility; rounds use 20 and final uses 30
  status           String   @default("SCHEDULED") // SCHEDULED | ACTIVE | COMPLETED
  createdBy        String // user id of organizer
  createdAt        DateTime @default(now())

  @@index([status, scheduledAt])
}

model TournamentParticipant {
  id              String    @id @default(cuid())
  tournamentId    String
  userId          String
  level           String // student's level (for tier-balanced brackets)
  bracketPosition Int? // position in bracket (0-based)
  isEliminated    Boolean   @default(false)
  score           Int? // final score
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId, level])
}

model TournamentMatch {
  id                      String    @id @default(cuid())
  tournamentId            String
  round                   Int // 1 = first round, 2 = quarter, etc.
  position                Int // slot within the round
  participantAId          String? // TournamentParticipant id (null for a bye)
  participantBId          String? // TournamentParticipant id (null for a bye)
  participantAStartedAt   DateTime?
  participantBStartedAt   DateTime?
  participantACompletedAt DateTime?
  participantBCompletedAt DateTime?
  participantAScore       Int?
  participantBScore       Int?
  winnerId                String? // TournamentParticipant id
  status                  String    @default("PENDING") // PENDING | IN_PROGRESS | TIEBREAKER | COMPLETED | BYE
  createdAt               DateTime  @default(now())

  @@index([tournamentId, round])
}

model TournamentTieBreaker {
  id                      String    @id @default(cuid())
  matchId                 String
  round                   Int
  questionId              String
  participantAAnswer      Int?
  participantBAnswer      Int?
  participantACompletedAt DateTime?
  participantBCompletedAt DateTime?
  winnerId                String?
  resolvedAt              DateTime?
  createdAt               DateTime  @default(now())

  @@unique([matchId, round])
  @@index([matchId, round])
}

model LeaderboardEntry {
  id           String   @id @default(cuid())
  userId       String
  totalPoints  Int      @default(0)
  dailyPoints  Int      @default(0)
  weeklyPoints Int      @default(0)
  academicYear String // e.g. "2025-2026"
  updatedAt    DateTime @updatedAt

  @@unique([userId, academicYear])
  @@index([academicYear, totalPoints])
}

model HallOfFame {
  id           String   @id @default(cuid())
  userId       String
  category     String // DAILY | WEEKLY
  academicYear String // e.g. "2025-2026"
  totalPoints  Int
  recordedAt   DateTime @default(now())

  @@unique([userId, category, academicYear])
}

// ─── Calendar & Group Management ────────────────────────────────────────────

// A named group of students, created and managed by a teacher (or admin).
model Group {
  id          String   @id @default(cuid())
  name        String
  createdById String // teacher/admin who owns the group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]
  eventLinks CalendarEventGroup[]

  @@index([createdById])
}

// Membership link between a group and a student.
model GroupMember {
  id        String @id @default(cuid())
  groupId   String
  studentId String // User id (role STUDENT)
  createdAt DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
}

// A calendar entry: a Lesson or a Call, either one-off or recurring.
//
// One-off events use `startDate` + `startTime`/`endTime`.
// Recurring events use `startDate`..`endDate` (range), `daysOfWeek`
// (JSON array of 0-6, 0=Sunday) and `schedules` (JSON map of weekday ->
// "HH:mm-HH:mm"). Editing a recurring event updates the whole series.
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("LESSON") // LESSON | CALL
  mode        String   @default("VIDEO") // VIDEO | IN_PERSON
  createdById String // teacher/admin who created the event

  // One-off scheduling
  startDate   DateTime // the date (one-off) or range start (recurring)
  startTime   String? // "HH:mm" (one-off)
  endTime     String? // "HH:mm" (one-off)

  // Recurring scheduling
  isRecurring Boolean  @default(false)
  endDate     DateTime? // range end (recurring only)
  daysOfWeek  String? // JSON array of weekday numbers 0-6 (recurring only)
  schedules   String? // JSON map: { "1": "06:00-07:00", ... } (recurring only)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CalendarEventCreator", fields: [createdById], references: [id])
  students CalendarEventStudent[]
  groups   CalendarEventGroup[]
  videoCall VideoCallSession?

  @@index([createdById])
  @@index([startDate])
}

// Direct student participants on an event.
model CalendarEventStudent {
  id        String @id @default(cuid())
  eventId   String
  studentId String // User id (role STUDENT)
  createdAt DateTime @default(now())

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId])
}

// Group participants on an event.
model CalendarEventGroup {
  id      String @id @default(cuid())
  eventId String
  groupId String
  createdAt DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([eventId, groupId])
  @@index([groupId])
}

// ─── Video Calls ────────────────────────────────────────────────────────────

// A video call session attached to a CalendarEvent of type CALL (mode VIDEO).
// The room is created lazily on first access; `jitsiRoomId` is the unique
// room name handed to the Jitsi Meet iframe.
model VideoCallSession {
  id           String   @id @default(cuid())
  eventId      String   @unique
  jitsiRoomId  String   @unique // unique room name for the WebRTC provider
  hostId       String // teacher/admin who owns the call
  status       String   @default("SCHEDULED") // SCHEDULED | ACTIVE | ENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([status])
}

// ─── Notifications ─────────────────────────────────────────────────────────

// In-app notification center. Emails are ONLY sent for video call invites;
// everything else lives here.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // QUIZ | DAILY_TASK | WEEKLY_TASK | TOURNAMENT | LESSON_REMINDER | VIDEO_CALL
  linkUrl   String // e.g. "/tasks/daily" or "/calendar"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Chat ──────────────────────────────────────────────────────────────────

// Friendship between two students. Teachers/Admins are contacts by default
// (no Friendship row needed) and can message any student directly.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String // student who sent the request
  addresseeId String // student who received the request
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// 1-to-1 conversation between two users.
model Conversation {
  id               String   @id @default(cuid())
  participantOneId String // lower id for deterministic ordering
  participantTwoId String // higher id
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  participantOne User @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo User @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([lastMessageAt])
}

// A message inside a conversation. Edit-only policy: no delete.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isEdited       Boolean  @default(false)
  lastEditedBy   String?
  editHistory    String? // JSON array of { previousContent, editedBy, editedAt }
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Attachments (photos, PDF, Word, ...). JSON array of
  // { id, name, mimeType, size, url, kind: 'image'|'file' }.
  attachments String? // JSON array of attachment objects

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Chat Groups (independent from calendar groups) ────────────────────────
// A group of students created by a teacher/admin for broadcasting chat
// messages. Has NO relation to the calendar Group model.

// A chat group owned by a teacher/admin.
model ChatGroup {
  id          String   @id @default(cuid())
  name        String
  createdById String // teacher/admin who owns the group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User             @relation("ChatGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   ChatGroupMember[]
  messages  ChatGroupMessage[]

  @@index([createdById])
}

// Membership link between a chat group and a student.
model ChatGroupMember {
  id        String @id @default(cuid())
  groupId   String
  studentId String // User id (role STUDENT)
  createdAt DateTime @default(now())

  group   ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
}

// A message inside a chat group. Edit-only policy: no delete.
model ChatGroupMessage {
  id          String   @id @default(cuid())
  groupId     String
  senderId    String
  content     String
  isEdited    Boolean  @default(false)
  lastEditedBy String?
  editHistory String? // JSON array of { previousContent, editedBy, editedAt }
  attachments String? // JSON array of attachment objects (same shape as Message)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group  ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation("ChatGroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  readBy ChatGroupMessageRead[]

  @@index([groupId, createdAt])
  @@index([senderId])
}

// Read receipt for a group message: one row per member who read it.
model ChatGroupMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message ChatGroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User             @relation("ChatGroupMessageReader", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// AI provider API keys. No API endpoint exposes this table — it is read
// directly by the aiProvider service and intended to be inspected/edited by
// the owner in the database only.
model AiApiKey {
  id       String @id @default(cuid())
  provider String @unique // gemini | groq | openrouter
  site     String // e.g. https://console.groq.com/keys
  apiKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tracks which AI provider is "locked in" for the rest of the day. When the
// primary (Gemini) quota is exhausted we switch to the next provider and
// remember it until the day rolls over, then we try Gemini again.
model AiProviderState {
  id            String   @id @default("default")
  activeProvider String  @default("gemini") // gemini | groq | openrouter
  lockedUntil   DateTime // end of the day the lock is valid (local time)
  updatedAt     DateTime @updatedAt
}
