# Dependencies
node_modules/

# Environment / secrets — never commit real credentials
.env
.env.local
.env.*.local

# Local databases (SQLite leftovers) — the production DB is remote PostgreSQL
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# Uploaded media — tracked in the repo so a fresh clone has all media.
# (On the server they are served from UPLOADS_DIR; keep the folder in sync.)

# Logs
*.log
logs/*
!logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
